{
  "name": "piste",
  "publisher": "tkt989",
  "displayName": "%piste.displayName%",
  "description": "%piste.description%",
  "license": "MIT",
  "version": "0.0.18",
  "repository": {
    "type": "git",
    "url": "https://github.com/tkt989/piste.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:piste.openToday",
    "onCommand:piste.openByDate",
    "onCommand:piste.searchMemos"
  ],
  "main": "./out/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "commands": [
      {
        "command": "piste.openToday",
        "title": "%piste.command.openToday%"
      },
      {
        "command": "piste.openByDate",
        "title": "%piste.command.openByDate%"
      },
      {
        "command": "piste.searchMemos",
        "title": "%piste.command.searchMemos%"
      }
    ],
    "configuration": {
      "title": "Daily Memo",
      "properties": {
        "piste.directory": {
          "type": "string",
          "default": "~/.daily-memo",
          "scope": "window",
          "description": "%piste.configuration.directory.description%"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  }
}
