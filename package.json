{
  "name": "piste",
  "publisher": "tkt989",
  "displayName": "%piste.displayName%",
  "description": "%piste.description%",
  "license": "MIT",
  "version": "0.0.17",
  "repository": {
    "type": "git",
    "url": "https://github.com/tkt989/piste.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:piste.openToday",
    "onCommand:piste.openByDate",
    "onCommand:piste.search",
    "onCommand:piste.clearSearchResults"
  ],
  "main": "./out/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "commands": [
      {
        "command": "piste.openToday",
        "title": "%piste.command.openToday%"
      },
      {
        "command": "piste.openByDate",
        "title": "%piste.command.openByDate%"
      },
      {
        "command": "piste.search",
        "title": "%piste.command.search%"
      },
      {
        "command": "piste.clearSearchResults",
        "title": "%piste.command.clearSearchResults%",
        "icon": "$(close)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "piste.clearSearchResults",
          "when": "view == piste.searchResults",
          "group": "navigation"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "piste.searchResults",
          "name": "%piste.view.searchResults%",
          "when": "piste.hasSearchResults"
        }
      ]
    },
    "configuration": {
      "title": "Daily Memo",
      "properties": {
        "piste.directory": {
          "type": "string",
          "default": "~/.daily-memo",
          "scope": "window",
          "description": "%piste.configuration.directory.description%"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "@vscode/ripgrep": "^1.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  }
}
